# ==============================================================================
# Edumy Mobile Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Backend API Base URL
# Android Emulator: http://10.0.2.2:5000/api/v1
# Real device (LAN): http://<LAN-IP>:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/v1

# Web Frontend Base URL (for "Mua trên website", quizzes, and certificate verification)
# Web browser: http://localhost:3000
# Android Emulator / Real device (LAN): http://<LAN-IP>:3000 (do NOT use localhost on physical devices)
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Optional Google AdMob Ad Unit IDs (leave empty in dev/demo to use official Google TestIds)
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
